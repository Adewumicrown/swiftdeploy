#!/usr/bin/env python3
"""
swiftdeploy — Declarative deployment CLI
Usage:
  ./swiftdeploy init
  ./swiftdeploy validate
  ./swiftdeploy deploy
  ./swiftdeploy promote [canary|stable]
  ./swiftdeploy teardown [--clean]
"""

import os
import sys
import time
import socket
import subprocess
import urllib.request
import urllib.error
import tempfile

# ── Optional deps with graceful error ─────────────────────────────────────────
try:
    import yaml
except ImportError:
    print("[error] PyYAML not installed. Run: pip install pyyaml ruamel.yaml jinja2")
    sys.exit(1)

try:
    from jinja2 import Environment, FileSystemLoader
except ImportError:
    print("[error] Jinja2 not installed. Run: pip install jinja2")
    sys.exit(1)

try:
    from ruamel.yaml import YAML as RuamelYAML
except ImportError:
    print("[error] ruamel.yaml not installed. Run: pip install ruamel.yaml")
    sys.exit(1)


# ── Paths ──────────────────────────────────────────────────────────────────────
ROOT          = os.path.dirname(os.path.abspath(__file__))
MANIFEST_PATH = os.path.join(ROOT, "manifest.yaml")
TEMPLATES_DIR = os.path.join(ROOT, "templates")
NGINX_CONF    = os.path.join(ROOT, "nginx.conf")
COMPOSE_FILE  = os.path.join(ROOT, "docker-compose.yml")


# ── Colours ────────────────────────────────────────────────────────────────────
GREEN  = "\033[92m"
RED    = "\033[91m"
YELLOW = "\033[93m"
CYAN   = "\033[96m"
BOLD   = "\033[1m"
RESET  = "\033[0m"

def ok(msg):     print(f"  {GREEN}✔ PASS{RESET}  {msg}")
def fail(msg):   print(f"  {RED}✘ FAIL{RESET}  {msg}")
def info(msg):   print(f"  {CYAN}→{RESET} {msg}")
def warn(msg):   print(f"  {YELLOW}⚠{RESET}  {msg}")
def banner(msg): print(f"\n{BOLD}{CYAN}{msg}{RESET}")


# ── Helpers ────────────────────────────────────────────────────────────────────
def load_manifest() -> dict:
    with open(MANIFEST_PATH, "r") as f:
        return yaml.safe_load(f)


def render_template(template_name: str, context: dict) -> str:
    env = Environment(loader=FileSystemLoader(TEMPLATES_DIR), trim_blocks=True, lstrip_blocks=True)
    tpl = env.get_template(template_name)
    return tpl.render(**context)


def run(cmd: str, capture=False):
    if capture:
        result = subprocess.run(cmd, shell=True, capture_output=True, text=True)
        return result.returncode, result.stdout.strip(), result.stderr.strip()
    else:
        return subprocess.run(cmd, shell=True).returncode, "", ""


def port_in_use(port: int) -> bool:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.settimeout(1)
        try:
            s.connect(("127.0.0.1", port))
            return True
        except (ConnectionRefusedError, OSError):
            return False


def health_check(port: int, path: str = "/healthz", timeout: int = 60) -> bool:
    url      = f"http://localhost:{port}{path}"
    deadline = time.time() + timeout
    attempt  = 0
    while time.time() < deadline:
        attempt += 1
        try:
            with urllib.request.urlopen(url, timeout=3) as resp:
                if resp.status == 200:
                    info(f"Health check passed after {attempt} attempt(s)")
                    return True
        except Exception:
            pass
        info(f"Waiting for service… (attempt {attempt})")
        time.sleep(2)
    return False


def build_context(manifest: dict) -> dict:
    return {
        "service_image":  manifest["services"]["image"],
        "service_port":   manifest["services"]["port"],
        "mode":           manifest["services"].get("mode", "stable"),
        "app_version":    manifest["services"].get("version", "1.0.0"),
        "nginx_image":    manifest["nginx"]["image"],
        "nginx_port":     manifest["nginx"]["port"],
        "proxy_timeout":  manifest["nginx"].get("proxy_timeout", 30),
        "network_name":   manifest["network"]["name"],
        "network_driver": manifest["network"]["driver_type"],
        "restart_policy": manifest.get("restart_policy", "unless-stopped"),
        "logs_volume":    manifest.get("volumes", {}).get("logs", "app-logs"),
    }


# ── Subcommands ────────────────────────────────────────────────────────────────

def cmd_init():
    banner("swiftdeploy init")
    manifest = load_manifest()
    ctx      = build_context(manifest)

    nginx_conf = render_template("nginx.conf.j2", ctx)
    with open(NGINX_CONF, "w") as f:
        f.write(nginx_conf)
    ok(f"Generated nginx.conf  (proxy → port {ctx['service_port']}, listen {ctx['nginx_port']})")

    compose = render_template("docker-compose.yml.j2", ctx)
    with open(COMPOSE_FILE, "w") as f:
        f.write(compose)
    ok(f"Generated docker-compose.yml  (mode={ctx['mode']})")

    info("Init complete — run './swiftdeploy validate' next")


def cmd_validate():
    banner("swiftdeploy validate")
    all_passed = True
    manifest   = {}

    # ── Check 1: manifest.yaml exists and is valid YAML ───────────────────────
    label = "manifest.yaml exists and is valid YAML"
    if not os.path.exists(MANIFEST_PATH):
        fail(f"{label}  — file not found")
        all_passed = False
    else:
        try:
            manifest = load_manifest()
            ok(label)
        except yaml.YAMLError as e:
            fail(f"{label}  — {e}")
            all_passed = False

    # ── Check 2: required fields present and non-empty ────────────────────────
    label    = "All required fields present and non-empty"
    required = [
        ("services", "image"),
        ("services", "port"),
        ("nginx",    "image"),
        ("nginx",    "port"),
        ("network",  "name"),
        ("network",  "driver_type"),
    ]
    missing = []
    for section, key in required:
        val = manifest.get(section, {}).get(key)
        if not val and val != 0:
            missing.append(f"{section}.{key}")
    if missing:
        fail(f"{label}  — missing: {', '.join(missing)}")
        all_passed = False
    else:
        ok(label)

    # ── Check 3: Docker image exists locally ──────────────────────────────────
    label = "Docker image exists locally"
    image = manifest.get("services", {}).get("image", "")
    rc, out, _ = run(f"docker images -q {image}", capture=True)
    if out:
        ok(f"{label}  ({image})")
    else:
        fail(f"{label}  — '{image}' not found. Run: docker build -t {image} .")
        all_passed = False

    # ── Check 4: Nginx port not already bound ─────────────────────────────────
    label      = "Nginx port not already bound on host"
    nginx_port = manifest.get("nginx", {}).get("port", 8080)

    # Allow port to be in use if it's OUR swiftdeploy-nginx container
    _, ps_out, _ = run("docker ps --format '{{.Names}}' --filter name=swiftdeploy-nginx", capture=True)
    our_nginx_running = "swiftdeploy-nginx" in ps_out

    if port_in_use(nginx_port) and not our_nginx_running:
        fail(f"{label}  — port {nginx_port} is in use by another process (not swiftdeploy)")
        all_passed = False
    else:
        ok(f"{label}  (port {nginx_port} is free or owned by swiftdeploy)")

    # ── Check 5: nginx.conf is syntactically valid ────────────────────────────
    label = "Generated nginx.conf is syntactically valid"
    if not os.path.exists(NGINX_CONF):
        fail(f"{label}  — nginx.conf not found. Run './swiftdeploy init' first")
        all_passed = False
    else:
        # Patch upstream hostname 'api' → '127.0.0.1' for syntax-check only.
        # During docker run there is no swiftdeploy network, so 'api' would
        # cause a DNS failure that has nothing to do with config syntax.
        with open(NGINX_CONF, "r") as f:
            conf_content = f.read()
        patched = conf_content.replace(
            "proxy_pass         http://api:",
            "proxy_pass         http://127.0.0.1:"
        )
        with tempfile.NamedTemporaryFile(mode="w", suffix=".conf", delete=False) as tmp:
            tmp.write(patched)
            tmp_path = tmp.name

        rc, _, err = run(
            f"docker run --rm "
            f"-v {tmp_path}:/etc/nginx/conf.d/default.conf:ro "
            f"nginx:latest nginx -t",
            capture=True
        )
        os.unlink(tmp_path)

        if rc == 0:
            ok(label)
        else:
            fail(f"{label}  — {err}")
            all_passed = False

    # ── Summary ───────────────────────────────────────────────────────────────
    print()
    if all_passed:
        print(f"{GREEN}{BOLD}All checks passed — ready to deploy!{RESET}")
        sys.exit(0)
    else:
        print(f"{RED}{BOLD}One or more checks failed. Fix the issues above before deploying.{RESET}")
        sys.exit(1)


def cmd_deploy():
    banner("swiftdeploy deploy")

    info("Running init…")
    cmd_init()

    manifest   = load_manifest()
    nginx_port = manifest["nginx"]["port"]
    image      = manifest["services"]["image"]

    rc, out, _ = run(f"docker images -q {image}", capture=True)
    if not out:
        print(f"\n{RED}Deploy aborted: image '{image}' not found locally.{RESET}")
        print(f"Run: docker build -t {image} .")
        sys.exit(1)

    info("Starting stack with docker compose…")
    rc, _, err = run(f"docker compose -f {COMPOSE_FILE} up -d --remove-orphans")
    if rc != 0:
        print(f"{RED}docker compose up failed:{RESET}\n{err}")
        sys.exit(1)

    info(f"Waiting for service health on port {nginx_port} (timeout 60s)…")
    if health_check(nginx_port, timeout=60):
        print(f"\n{GREEN}{BOLD}✔ Stack is up and healthy!{RESET}")
        print(f"  API:    http://localhost:{nginx_port}/")
        print(f"  Health: http://localhost:{nginx_port}/healthz")
    else:
        print(f"\n{RED}{BOLD}✘ Health check timed out after 60s{RESET}")
        print("  Check logs with: docker compose logs")
        sys.exit(1)


def cmd_promote(target: str):
    banner(f"swiftdeploy promote {target}")

    if target not in ("canary", "stable"):
        print(f"{RED}Usage: ./swiftdeploy promote [canary|stable]{RESET}")
        sys.exit(1)

    ryaml = RuamelYAML()
    ryaml.preserve_quotes = True
    with open(MANIFEST_PATH, "r") as f:
        data = ryaml.load(f)

    current_mode = data["services"].get("mode", "stable")
    if current_mode == target:
        warn(f"Already in {target} mode — nothing to do")
        sys.exit(0)

    data["services"]["mode"] = target
    with open(MANIFEST_PATH, "w") as f:
        ryaml.dump(data, f)
    ok(f"manifest.yaml updated  mode: {current_mode} → {target}")

    manifest = load_manifest()
    ctx      = build_context(manifest)
    compose  = render_template("docker-compose.yml.j2", ctx)
    with open(COMPOSE_FILE, "w") as f:
        f.write(compose)
    ok(f"docker-compose.yml regenerated with MODE={target}")

    info("Restarting API service container only…")
    rc, _, err = run(f"docker compose -f {COMPOSE_FILE} up -d --no-deps api")
    if rc != 0:
        print(f"{RED}Restart failed:{RESET} {err}")
        sys.exit(1)
    ok("API container restarted")

    nginx_port = manifest["nginx"]["port"]
    info(f"Confirming new mode via http://localhost:{nginx_port}/healthz…")
    time.sleep(3)

    url = f"http://localhost:{nginx_port}/healthz"
    try:
        with urllib.request.urlopen(url, timeout=10) as resp:
            body = resp.read().decode()
            if target in body:
                ok(f"Confirmed: service is now running in {BOLD}{target}{RESET} mode")
            else:
                warn(f"Service responded but mode not confirmed in body: {body}")
    except Exception as e:
        fail(f"Could not reach /healthz: {e}")
        sys.exit(1)

    print(f"\n{GREEN}{BOLD}✔ Promote to '{target}' complete!{RESET}")


def cmd_teardown(clean: bool = False):
    banner("swiftdeploy teardown")

    info("Stopping and removing containers, networks, and volumes…")
    rc, _, err = run(f"docker compose -f {COMPOSE_FILE} down -v --remove-orphans")
    if rc == 0:
        ok("Stack torn down successfully")
    else:
        warn(f"docker compose down exited with code {rc}: {err}")

    if clean:
        info("--clean flag set: removing generated config files…")
        for path, label in [(NGINX_CONF, "nginx.conf"), (COMPOSE_FILE, "docker-compose.yml")]:
            if os.path.exists(path):
                os.remove(path)
                ok(f"Deleted {label}")
            else:
                warn(f"{label} not found — skipping")

    print(f"\n{GREEN}{BOLD}✔ Teardown complete{RESET}")


# ── Entry point ────────────────────────────────────────────────────────────────
def main():
    args = sys.argv[1:]

    if not args:
        print(__doc__)
        sys.exit(0)

    cmd = args[0]

    if cmd == "init":
        cmd_init()
    elif cmd == "validate":
        cmd_validate()
    elif cmd == "deploy":
        cmd_deploy()
    elif cmd == "promote":
        if len(args) < 2:
            print(f"{RED}Usage: ./swiftdeploy promote [canary|stable]{RESET}")
            sys.exit(1)
        cmd_promote(args[1])
    elif cmd == "teardown":
        cmd_teardown(clean="--clean" in args)
    else:
        print(f"{RED}Unknown command: {cmd}{RESET}")
        print(__doc__)
        sys.exit(1)


if __name__ == "__main__":
    main()
