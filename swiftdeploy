#!/usr/bin/env python3
"""
swiftdeploy — Declarative deployment CLI with policy enforcement
Usage:
  ./swiftdeploy init
  ./swiftdeploy validate
  ./swiftdeploy deploy
  ./swiftdeploy promote [canary|stable]
  ./swiftdeploy status
  ./swiftdeploy audit
  ./swiftdeploy teardown [--clean]
"""

import os, sys, time, socket, subprocess, urllib.request, urllib.error
import json, tempfile, shutil
from datetime import datetime, timezone

try:
    import yaml
except ImportError:
    print("[error] PyYAML not installed. Run: pip install pyyaml"); sys.exit(1)

try:
    from jinja2 import Environment, FileSystemLoader
except ImportError:
    print("[error] Jinja2 not installed. Run: pip install jinja2"); sys.exit(1)

try:
    from ruamel.yaml import YAML as RuamelYAML
except ImportError:
    print("[error] ruamel.yaml not installed. Run: pip install ruamel.yaml"); sys.exit(1)

# ── Paths ──────────────────────────────────────────────────────────────────────
ROOT          = os.path.dirname(os.path.abspath(__file__))
MANIFEST_PATH = os.path.join(ROOT, "manifest.yaml")
TEMPLATES_DIR = os.path.join(ROOT, "templates")
POLICIES_DIR  = os.path.join(ROOT, "policies")
NGINX_CONF    = os.path.join(ROOT, "nginx.conf")
COMPOSE_FILE  = os.path.join(ROOT, "docker-compose.yml")
HISTORY_FILE  = os.path.join(ROOT, "history.jsonl")
AUDIT_FILE    = os.path.join(ROOT, "audit_report.md")

# ── Colours ────────────────────────────────────────────────────────────────────
GREEN  = "\033[92m"; RED    = "\033[91m"; YELLOW = "\033[93m"
CYAN   = "\033[96m"; BOLD   = "\033[1m";  RESET  = "\033[0m"
BLUE   = "\033[94m"; MAGENTA= "\033[95m"

def ok(msg):     print(f"  {GREEN}✔ PASS{RESET}  {msg}")
def fail(msg):   print(f"  {RED}✘ FAIL{RESET}  {msg}")
def info(msg):   print(f"  {CYAN}→{RESET} {msg}")
def warn(msg):   print(f"  {YELLOW}⚠{RESET}  {msg}")
def banner(msg): print(f"\n{BOLD}{CYAN}{msg}{RESET}")
def policy_ok(msg):   print(f"  {GREEN}✔ ALLOW{RESET} [{BOLD}policy{RESET}] {msg}")
def policy_fail(msg): print(f"  {RED}✘ BLOCK{RESET} [{BOLD}policy{RESET}] {msg}")


# ── Helpers ────────────────────────────────────────────────────────────────────
def load_manifest() -> dict:
    with open(MANIFEST_PATH, "r") as f:
        return yaml.safe_load(f)

def render_template(name: str, ctx: dict) -> str:
    env = Environment(loader=FileSystemLoader(TEMPLATES_DIR), trim_blocks=True, lstrip_blocks=True)
    return env.get_template(name).render(**ctx)

def run(cmd: str, capture=False):
    if capture:
        r = subprocess.run(cmd, shell=True, capture_output=True, text=True)
        return r.returncode, r.stdout.strip(), r.stderr.strip()
    return subprocess.run(cmd, shell=True).returncode, "", ""

def port_in_use(port: int) -> bool:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.settimeout(1)
        try:
            s.connect(("127.0.0.1", port)); return True
        except (ConnectionRefusedError, OSError):
            return False

def health_check(port: int, path="/healthz", timeout=60) -> bool:
    url = f"http://localhost:{port}{path}"
    deadline = time.time() + timeout
    attempt  = 0
    while time.time() < deadline:
        attempt += 1
        try:
            with urllib.request.urlopen(url, timeout=3) as r:
                if r.status == 200:
                    info(f"Health check passed after {attempt} attempt(s)")
                    return True
        except Exception:
            pass
        info(f"Waiting for service… (attempt {attempt})")
        time.sleep(2)
    return False

def build_context(manifest: dict) -> dict:
    return {
        "service_image":  manifest["services"]["image"],
        "service_port":   manifest["services"]["port"],
        "mode":           manifest["services"].get("mode", "stable"),
        "app_version":    manifest["services"].get("version", "1.0.0"),
        "nginx_image":    manifest["nginx"]["image"],
        "nginx_port":     manifest["nginx"]["port"],
        "proxy_timeout":  manifest["nginx"].get("proxy_timeout", 30),
        "opa_image":      manifest.get("opa", {}).get("image", "openpolicyagent/opa:latest"),
        "opa_port":       manifest.get("opa", {}).get("port", 8181),
        "network_name":   manifest["network"]["name"],
        "network_driver": manifest["network"]["driver_type"],
        "restart_policy": manifest.get("restart_policy", "unless-stopped"),
        "logs_volume":    manifest.get("volumes", {}).get("logs", "app-logs"),
    }

def now_iso() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

def append_history(record: dict):
    record["timestamp"] = now_iso()
    with open(HISTORY_FILE, "a") as f:
        f.write(json.dumps(record) + "\n")


# ── OPA helpers ───────────────────────────────────────────────────────────────
def get_opa_url() -> str:
    manifest = load_manifest()
    port = manifest.get("opa", {}).get("port", 8181)
    return f"http://localhost:{port}"

def opa_query(package_path: str, input_data: dict) -> dict | None:
    """
    Query OPA for a decision. Returns the decision dict or None on failure.
    package_path example: "swiftdeploy/infrastructure"
    """
    url     = f"{get_opa_url()}/v1/data/{package_path}/decision"
    payload = json.dumps({"input": input_data}).encode()
    req     = urllib.request.Request(
        url, data=payload,
        headers={"Content-Type": "application/json"},
        method="POST"
    )
    try:
        with urllib.request.urlopen(req, timeout=5) as resp:
            body = json.loads(resp.read())
            return body.get("result")
    except urllib.error.URLError as e:
        warn(f"OPA unreachable ({e.reason}) — policy check skipped for {package_path}")
        return None
    except Exception as e:
        warn(f"OPA error for {package_path}: {e}")
        return None

def enforce_policy(decision: dict | None, domain: str) -> bool:
    """Print decision reasoning and return True=allowed, False=blocked."""
    if decision is None:
        warn(f"[{domain}] OPA unavailable — proceeding without policy gate")
        return True  # fail-open so deploy isn't broken by OPA being down

    if decision.get("allow"):
        policy_ok(f"[{domain}] All policy checks passed")
        return True
    else:
        violations = decision.get("violations", ["No details returned"])
        for v in violations:
            policy_fail(f"[{domain}] {v}")
        return False


# ── Host stats ────────────────────────────────────────────────────────────────
def get_host_stats() -> dict:
    stats = {}

    # Disk free in GB on /
    rc, out, _ = run("df -BG / | awk 'NR==2{print $4}'", capture=True)
    try:
        stats["disk_free_gb"] = float(out.replace("G", ""))
    except Exception:
        stats["disk_free_gb"] = 999.0

    # CPU load (1-min average)
    rc, out, _ = run("cat /proc/loadavg | awk '{print $1}'", capture=True)
    try:
        stats["cpu_load"] = float(out)
    except Exception:
        stats["cpu_load"] = 0.0

    # Available memory %
    rc, out, _ = run("free | awk '/^Mem/{printf \"%.1f\", $7/$2*100}'", capture=True)
    try:
        stats["mem_available_pct"] = float(out)
    except Exception:
        stats["mem_available_pct"] = 100.0

    return stats


# ── Metrics scraper ───────────────────────────────────────────────────────────
def scrape_metrics(nginx_port: int) -> dict:
    """Scrape /metrics and return parsed dict."""
    try:
        url = f"http://localhost:{nginx_port}/metrics"
        with urllib.request.urlopen(url, timeout=5) as r:
            raw = r.read().decode()
        return parse_prometheus(raw)
    except Exception as e:
        warn(f"Could not scrape /metrics: {e}")
        return {}

def parse_prometheus(text: str) -> dict:
    """Parse Prometheus text format into a dict."""
    data = {"counters": {}, "gauges": {}, "histograms": {}}
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.rsplit(" ", 1)
        if len(parts) != 2:
            continue
        metric, value = parts[0], float(parts[1])
        if "{" in metric:
            name, labels_str = metric.split("{", 1)
            labels_str = labels_str.rstrip("}")
        else:
            name, labels_str = metric, ""

        if name in ("app_uptime_seconds", "app_mode", "chaos_active"):
            data["gauges"][name] = value
        elif name == "http_requests_total":
            data["counters"].setdefault(name, []).append((labels_str, value))
        elif "_bucket" in name or "_sum" in name or "_count" in name:
            data["histograms"].setdefault(name, []).append((labels_str, value))
    return data

def calc_error_rate(metrics: dict) -> float:
    """Return error rate as a percentage."""
    total = 0; errors = 0
    for labels, val in metrics.get("counters", {}).get("http_requests_total", []):
        total += val
        if 'status_code="5' in labels:
            errors += val
    if total == 0:
        return 0.0
    return round((errors / total) * 100, 2)

def calc_p99_latency_ms(metrics: dict) -> float:
    """Estimate P99 latency from histogram buckets in ms."""
    buckets = []
    total_count = 0
    for labels, val in metrics.get("histograms", {}).get("http_request_duration_seconds_bucket", []):
        if 'le="+Inf"' in labels:
            total_count = val
        else:
            try:
                le = float(labels.split('le="')[1].rstrip('"'))
                buckets.append((le, val))
            except Exception:
                pass
    if not buckets or total_count == 0:
        return 0.0
    buckets.sort(key=lambda x: x[0])
    p99_target = total_count * 0.99
    for le, cumulative in buckets:
        if cumulative >= p99_target:
            return round(le * 1000, 1)
    return buckets[-1][0] * 1000


# ── Subcommands ────────────────────────────────────────────────────────────────

def cmd_init():
    banner("swiftdeploy init")
    manifest = load_manifest()
    ctx      = build_context(manifest)

    # Ensure policies dir exists
    os.makedirs(POLICIES_DIR, exist_ok=True)

    nginx_conf = render_template("nginx.conf.j2", ctx)
    with open(NGINX_CONF, "w") as f:
        f.write(nginx_conf)
    ok(f"Generated nginx.conf  (proxy → port {ctx['service_port']}, listen {ctx['nginx_port']})")

    compose = render_template("docker-compose.yml.j2", ctx)
    with open(COMPOSE_FILE, "w") as f:
        f.write(compose)
    ok(f"Generated docker-compose.yml  (mode={ctx['mode']}, opa={ctx['opa_port']})")

    rego_files = [f for f in os.listdir(POLICIES_DIR) if f.endswith(".rego")]
    ok(f"Policies directory ready  ({len(rego_files)} .rego file(s): {', '.join(rego_files) or 'none'})")
    info("Init complete — run './swiftdeploy validate' next")


def cmd_validate():
    banner("swiftdeploy validate")
    all_passed = True
    manifest   = {}

    label = "manifest.yaml exists and is valid YAML"
    if not os.path.exists(MANIFEST_PATH):
        fail(f"{label}  — file not found"); all_passed = False
    else:
        try:
            manifest = load_manifest(); ok(label)
        except yaml.YAMLError as e:
            fail(f"{label}  — {e}"); all_passed = False

    label    = "All required fields present and non-empty"
    required = [("services","image"),("services","port"),("nginx","image"),("nginx","port"),("network","name"),("network","driver_type")]
    missing  = [f"{s}.{k}" for s,k in required if not manifest.get(s,{}).get(k) and manifest.get(s,{}).get(k) != 0]
    if missing:
        fail(f"{label}  — missing: {', '.join(missing)}"); all_passed = False
    else:
        ok(label)

    label = "Docker image exists locally"
    image = manifest.get("services", {}).get("image", "")
    rc, out, _ = run(f"docker images -q {image}", capture=True)
    if out:
        ok(f"{label}  ({image})")
    else:
        fail(f"{label}  — '{image}' not found. Run: docker build -t {image} ."); all_passed = False

    label      = "Nginx port not already bound on host"
    nginx_port = manifest.get("nginx", {}).get("port", 8080)
    _, ps_out, _ = run("docker ps --format '{{.Names}}' --filter name=swiftdeploy-nginx", capture=True)
    if port_in_use(nginx_port) and "swiftdeploy-nginx" not in ps_out:
        fail(f"{label}  — port {nginx_port} in use by another process"); all_passed = False
    else:
        ok(f"{label}  (port {nginx_port} is free or owned by swiftdeploy)")

    label = "Generated nginx.conf is syntactically valid"
    if not os.path.exists(NGINX_CONF):
        fail(f"{label}  — nginx.conf not found. Run './swiftdeploy init' first"); all_passed = False
    else:
        with open(NGINX_CONF) as f:
            conf = f.read()
        patched = conf.replace("proxy_pass         http://api:", "proxy_pass         http://127.0.0.1:")
        with tempfile.NamedTemporaryFile(mode="w", suffix=".conf", delete=False) as tmp:
            tmp.write(patched); tmp_path = tmp.name
        rc, _, err = run(f"docker run --rm -v {tmp_path}:/etc/nginx/conf.d/default.conf:ro nginx:latest nginx -t", capture=True)
        os.unlink(tmp_path)
        if rc == 0:
            ok(label)
        else:
            fail(f"{label}  — {err}"); all_passed = False

    print()
    if all_passed:
        print(f"{GREEN}{BOLD}All checks passed — ready to deploy!{RESET}"); sys.exit(0)
    else:
        print(f"{RED}{BOLD}One or more checks failed.{RESET}"); sys.exit(1)


def cmd_deploy():
    banner("swiftdeploy deploy")
    info("Running init…")
    cmd_init()

    manifest   = load_manifest()
    nginx_port = manifest["nginx"]["port"]
    thresholds = manifest.get("thresholds", {})
    image      = manifest["services"]["image"]

    rc, out, _ = run(f"docker images -q {image}", capture=True)
    if not out:
        print(f"\n{RED}Deploy aborted: image '{image}' not found.{RESET}"); sys.exit(1)

    # ── Pre-deploy policy check ───────────────────────────────────────────────
    banner("Pre-deploy policy check")
    stats = get_host_stats()
    info(f"Host stats → disk={stats['disk_free_gb']:.1f}GB  cpu={stats['cpu_load']:.2f}  mem={stats['mem_available_pct']:.1f}%")

    input_data = {
        "disk_free_gb":        stats["disk_free_gb"],
        "cpu_load":            stats["cpu_load"],
        "mem_available_pct":   stats["mem_available_pct"],
        "thresholds":          thresholds,
        "checked_at":          now_iso(),
        "context":             "pre-deploy",
    }

    decision = opa_query("swiftdeploy/infrastructure", input_data)
    allowed  = enforce_policy(decision, "infrastructure")

    append_history({
        "event":    "pre-deploy-policy",
        "domain":   "infrastructure",
        "input":    input_data,
        "decision": decision,
        "allowed":  allowed,
    })

    if not allowed:
        print(f"\n{RED}{BOLD}✘ Deploy blocked by policy.{RESET}")
        sys.exit(1)

    # ── Bring up stack ────────────────────────────────────────────────────────
    info("Starting stack with docker compose…")
    rc, _, err = run(f"docker compose -f {COMPOSE_FILE} up -d --remove-orphans")
    if rc != 0:
        print(f"{RED}docker compose up failed:{RESET}\n{err}"); sys.exit(1)

    info(f"Waiting for service health on port {nginx_port} (timeout 60s)…")
    if health_check(nginx_port, timeout=60):
        append_history({"event": "deploy", "mode": manifest["services"].get("mode","stable"), "status": "success"})
        print(f"\n{GREEN}{BOLD}✔ Stack is up and healthy!{RESET}")
        print(f"  API:    http://localhost:{nginx_port}/")
        print(f"  Health: http://localhost:{nginx_port}/healthz")
        print(f"  Metrics: http://localhost:{nginx_port}/metrics")
    else:
        append_history({"event": "deploy", "status": "failed"})
        print(f"\n{RED}{BOLD}✘ Health check timed out after 60s{RESET}")
        sys.exit(1)


def cmd_promote(target: str):
    banner(f"swiftdeploy promote {target}")
    if target not in ("canary", "stable"):
        print(f"{RED}Usage: ./swiftdeploy promote [canary|stable]{RESET}"); sys.exit(1)

    manifest   = load_manifest()
    nginx_port = manifest["nginx"]["port"]
    thresholds = manifest.get("thresholds", {})

    # ── Pre-promote policy check (canary→stable skips canary safety) ──────────
    if target == "stable":
        banner("Pre-promote policy check (stable — skipping canary safety)")
        info("Promoting to stable — canary safety check not required")
    else:
        banner("Pre-promote policy check")
        metrics = scrape_metrics(nginx_port)
        error_rate  = calc_error_rate(metrics)
        p99_latency = calc_p99_latency_ms(metrics)
        chaos_val   = int(metrics.get("gauges", {}).get("chaos_active", 0))

        info(f"Canary metrics → error_rate={error_rate}%  p99={p99_latency}ms  chaos={chaos_val}")

        input_data = {
            "metrics": {
                "error_rate_pct":  error_rate,
                "p99_latency_ms":  p99_latency,
                "sample_count":    int(sum(v for _, v in metrics.get("counters", {}).get("http_requests_total", []))),
        },
            "thresholds":      thresholds,
            "checked_at":      now_iso(),
            "context":         "pre-promote",
            "chaos_active":    chaos_val,
        }
        decision = opa_query("swiftdeploy/canary", input_data)
        allowed  = enforce_policy(decision, "canary")

        append_history({
            "event":        "pre-promote-policy",
            "domain":       "canary",
            "target":       target,
            "input":        input_data,
            "decision":     decision,
            "allowed":      allowed,
        })

        if not allowed:
            print(f"\n{RED}{BOLD}✘ Promotion blocked by policy.{RESET}")
            sys.exit(1)

    # ── Update manifest + regenerate compose ──────────────────────────────────
    ryaml = RuamelYAML(); ryaml.preserve_quotes = True
    with open(MANIFEST_PATH) as f:
        data = ryaml.load(f)
    current_mode = data["services"].get("mode", "stable")
    if current_mode == target:
        warn(f"Already in {target} mode — nothing to do"); sys.exit(0)
    data["services"]["mode"] = target
    with open(MANIFEST_PATH, "w") as f:
        ryaml.dump(data, f)
    ok(f"manifest.yaml updated  mode: {current_mode} → {target}")

    manifest = load_manifest()
    ctx      = build_context(manifest)
    with open(COMPOSE_FILE, "w") as f:
        f.write(render_template("docker-compose.yml.j2", ctx))
    ok(f"docker-compose.yml regenerated with MODE={target}")

    info("Restarting API service container only…")
    rc, _, err = run(f"docker compose -f {COMPOSE_FILE} up -d --no-deps api")
    if rc != 0:
        print(f"{RED}Restart failed:{RESET} {err}"); sys.exit(1)
    ok("API container restarted")

    time.sleep(3)
    url = f"http://localhost:{nginx_port}/healthz"
    try:
        with urllib.request.urlopen(url, timeout=10) as resp:
            body = resp.read().decode()
            if target in body:
                ok(f"Confirmed: service is now running in {BOLD}{target}{RESET} mode")
            else:
                warn(f"Service responded but mode not confirmed: {body}")
    except Exception as e:
        fail(f"Could not reach /healthz: {e}"); sys.exit(1)

    append_history({"event": "promote", "from": current_mode, "to": target, "status": "success"})
    print(f"\n{GREEN}{BOLD}✔ Promote to '{target}' complete!{RESET}")


def cmd_status():
    banner("swiftdeploy status  (Ctrl+C to exit)")
    manifest   = load_manifest()
    nginx_port = manifest["nginx"]["port"]
    thresholds = manifest.get("thresholds", {})
    prev_counts = {}

    try:
        while True:
            os.system("clear")
            ts = now_iso()
            print(f"{BOLD}{CYAN}╔══════════════════════════════════════════════════╗")
            print(f"║        SwiftDeploy Live Status Dashboard         ║")
            print(f"╚══════════════════════════════════════════════════╝{RESET}")
            print(f"  {CYAN}Time:{RESET} {ts}")

            metrics = scrape_metrics(nginx_port)

            if not metrics:
                print(f"\n  {RED}Could not reach /metrics — is the stack running?{RESET}")
            else:
                gauges      = metrics.get("gauges", {})
                mode_val    = int(gauges.get("app_mode", 0))
                chaos_val   = int(gauges.get("chaos_active", 0))
                uptime      = gauges.get("app_uptime_seconds", 0)
                error_rate  = calc_error_rate(metrics)
                p99_latency = calc_p99_latency_ms(metrics)

                mode_str  = f"{MAGENTA}canary{RESET}" if mode_val else f"{GREEN}stable{RESET}"
                chaos_map = {0: f"{GREEN}none{RESET}", 1: f"{YELLOW}slow{RESET}", 2: f"{RED}error{RESET}"}
                chaos_str = chaos_map.get(chaos_val, str(chaos_val))

                # Calculate req/s delta
                current_counts = {}
                for labels, val in metrics.get("counters", {}).get("http_requests_total", []):
                    current_counts[labels] = val
                total_now  = sum(current_counts.values())
                total_prev = sum(prev_counts.values())
                rps = round((total_now - total_prev) / 5, 2)
                prev_counts = current_counts

                print(f"\n  {BOLD}── Service State ──────────────────────────────────{RESET}")
                print(f"  Mode:        {mode_str}")
                print(f"  Chaos:       {chaos_str}")
                print(f"  Uptime:      {uptime:.0f}s")

                print(f"\n  {BOLD}── Live Metrics ───────────────────────────────────{RESET}")
                print(f"  Req/s:       {rps}")
                err_color = RED if error_rate > thresholds.get("max_error_rate_pct", 1.0) else GREEN
                lat_color = RED if p99_latency > thresholds.get("max_p99_latency_ms", 500) else GREEN
                print(f"  Error Rate:  {err_color}{error_rate}%{RESET}")
                print(f"  P99 Latency: {lat_color}{p99_latency}ms{RESET}")

                # Policy compliance
                print(f"\n  {BOLD}── Policy Compliance ──────────────────────────────{RESET}")
                host = get_host_stats()
                checks = [
                    ("Disk Free",   host["disk_free_gb"] >= thresholds.get("min_disk_free_gb", 10),   f"{host['disk_free_gb']:.1f}GB"),
                    ("CPU Load",    host["cpu_load"] <= thresholds.get("max_cpu_load", 2.0),           f"{host['cpu_load']:.2f}"),
                    ("Memory",      host["mem_available_pct"] >= thresholds.get("min_mem_available_pct", 10), f"{host['mem_available_pct']:.1f}%"),
                    ("Error Rate",  error_rate <= thresholds.get("max_error_rate_pct", 1.0),           f"{error_rate}%"),
                    ("P99 Latency", p99_latency <= thresholds.get("max_p99_latency_ms", 500),          f"{p99_latency}ms"),
                    ("Chaos Free",  chaos_val == 0,                                                    chaos_map.get(chaos_val,"")),
                ]
                for name, passing, val in checks:
                    symbol = f"{GREEN}✔{RESET}" if passing else f"{RED}✘{RESET}"
                    print(f"  {symbol} {name:<14} {val}")

                # Append to history
                append_history({
                    "event":        "status-scrape",
                    "mode"      "canary" if mode_val else "stable",
                    "chaos_active": chaos_val,
                    "error_rate":   error_rate,
                    "p99_latency":  p99_latency,
                    "rps":          rps,
                    "host":         host,
                })

            print(f"\n  {YELLOW}Refreshing every 5s — Ctrl+C to exit{RESET}")
            time.sleep(5)

    except KeyboardInterrupt:
        print(f"\n{CYAN}Status dashboard exited.{RESET}")


def cmd_audit():
    banne"swiftdeploy audit")

    if not os.path.exists(HISTORY_FILE):
        print(f"{RED}No history.jsonl found — run deploy/status first to generate data.{RESET}")
        sys.exit(1)

    records = []
    with open(HISTORY_FILE) as f:
        for line in f:
            line = line.strip()
            if line:
                try:
                    records.append(json.loads(line))
                except Exception:
                    pass

    if not records:
        print(f"{RED}history.jsonl is empty.{RES}"); sys.exit(1)

    lines = []
    lines.append("# SwiftDeploy Audit Report")
    lines.append(f"\n**Generated:** {now_iso()}  ")
    lines.append(f"**Total Events:** {len(records)}  ")
    lines.append("")

    # ── Timeline table ────────────────────────────────────────────────────────
    lines.append("## Timeline")
    lines.append("")
    lines.append("| Timestamp | Event | Details |")
lines.append("|-----------|-------|---------|")

    for r in records:
        ts    = r.get("timestamp", "—")
        event = r.get("event", "—")
        if event == "deploy":
            detail = f"Deploy {r.get('status','')} — mode={r.get('mode','')}"
        elif event == "promote":
            detail = f"{r.get('from','')} → {r.get('to','')} ({r.get('status','')})"
        elif event == "status-scrape":
            detail = f"mode={r.get('mode','')} err={r.get('error_rate','')}% p99={r.get('p99','')}ms rps={r.get('rps','')}"
        elif event == "pre-deploy-policy":
            allowed = r.get("allowed", True)
            detail  = f"infrastructure policy → {'ALLOW' if allowed else 'BLOCK'}"
        elif event == "pre-promote-policy":
            allowed = r.get("allowed", True)
            detail  = f"canary policy → {'ALLOW' if allowed else 'BLOCK'} (target={r.get('target','')})"
        else:
            detail = str(r)[:80]
        lines.append(f"| {ts} | `{event}` | {detail} |")

    # iolations section ────────────────────────────────────────────────────
    lines.append("")
    lines.append("## Policy Violations")
    lines.append("")

    violations_found = False
    for r in records:
        if r.get("event") in ("pre-deploy-policy", "pre-promote-policy") and not r.get("allowed", True):
            violations_found = True
            ts      = r.get("timestamp", "—")
            d.get("domain", "—")
            decision = r.get("decision") or {}
            viols   = decision.get("violations", [])
            lines.append(f"### {ts} — `{domain}` policy blocked")
            lines.append("")
            for v in viols:
                lines.append(f"- {v}")
            lines.append("")

    if not violations_found:
        lines.append("_No policy violations recorded._")

    # ── Mode changes ───────────────────────────â──────────────
    lines.append("")
    lines.append("## Mode Changes")
    lines.append("")
    lines.append("| Timestamp | From | To |")
    lines.append("|-----------|------|----|")
    mode_changes = [r for r in records if r.get("event") == "promote"]
    if mode_changes:
        for r in mode_changes:
            lines.append(f"| {r.get('timestamp','—')} | `{r.get('from','—')}` | `{r.get('to','—')}` |")
    else:
        lines.append("| — | — | No mode changes r|")

    # ── Chaos events ──────────────────────────────────────────────────────────
    lines.append("")
    lines.append("## Chaos Events")
    lines.append("")
    chaos_records = [r for r in records if r.get("event") == "status-scrape" and r.get("chaos_active", 0) != 0]
    if chaos_records:
        lines.append("| Timestamp | Chaos State | Error Rate | P99 Latency |")
        lines.a-----------|-------------|------------|-------------|")
        chaos_map = {1: "slow", 2: "error"}
        for r in chaos_records:
            lines.append(f"| {r.get('timestamp','—')} | `{chaos_map.get(r.get('chaos_active',0),'unknown')}` | {r.get('error_rate','')}% | {r.get('p99_latency','')}ms |")
    else:
        lines.append("_No chaos events recorded._")

    with open(AUDIT_FILE, "w") as f:
        f.write("\n".join(lines) + "\n")

    ok(f"Audit report written to {AUDIT_FILE}")
    info(f"View wh: cat {AUDIT_FILE}")


def cmd_teardown(clean=False):
    banner("swiftdeploy teardown")
    info("Stopping and removing containers, networks, and volumes…")
    rc, _, err = run(f"docker compose -f {COMPOSE_FILE} down -v --remove-orphans")
    if rc == 0:
        ok("Stack torn down successfully")
    else:
        warn(f"docker compose down exited {rc}: {err}")

    if clean:
        info("--clean flag: removing generated config files…")
        for path, label in [(NGINX_CONF,"nginx.conf"),(COMPOSE_,"docker-compose.yml")]:
            if os.path.exists(path):
                os.remove(path); ok(f"Deleted {label}")
            else:
                warn(f"{label} not found — skipping")

    print(f"\n{GREEN}{BOLD}✔ Teardown complete{RESET}")


# ── Entry point ────────────────────────────────────────────────────────────────
def main():
    args = sys.argv[1:]
    if no        print(__doc__); sys.exit(0)

    cmd = args[0]
    if   cmd == "init":     cmd_init()
    elif cmd == "validate": cmd_validate()
    elif cmd == "deploy":   cmd_deploy()
    elif cmd == "promote":
        if len(args) < 2:
            print(f"{RED}Usage: ./swiftdeploy promote [canary|stable]{RESET}"); sys.exit(1)
        cmd_promote(args[1])
    elif cmd == "status":   cmd_status()
    elif cmd == "audit":    cmd_audit()
    elif cmd == "teardown": cmd_teardown(clean="--clean" in args)
    else:
        print(f"{RED}Unknown command: {cmd}{RESET}"); print(__doc__); sys.exit(1)

if __name__ == "__main__":
    main()
