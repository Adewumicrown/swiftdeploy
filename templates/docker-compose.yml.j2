# Generated by swiftdeploy init — DO NOT EDIT MANUALLY

services:

  api:
    image: {{ service_image }}
    container_name: swiftdeploy-api
    restart: {{ restart_policy }}
    environment:
      MODE: "{{ mode }}"
      APP_VERSION: "{{ app_version }}"
      APP_PORT: "{{ service_port }}"
    # Port is intentionally NOT exposed — all traffic routes through Nginx
    networks:
      - {{ network_name }}
    volumes:
      - {{ logs_volume }}:/app/logs
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://localhost:{{ service_port }}/healthz"]
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: 10s

  nginx:
    image: {{ nginx_image }}
    container_name: swiftdeploy-nginx
    restart: {{ restart_policy }}
    ports:
      - "{{ nginx_port }}:{{ nginx_port }}"
    volumes:
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
      - nginx-logs:/var/log/nginx
    networks:
      - {{ network_name }}
    depends_on:
      api:
        condition: service_healthy
    cap_drop:
      - ALL
    cap_add:
      - NET_BIND_SERVICE
      - CHOWN
      - SETUID
      - SETGID
    security_opt:
      - no-new-privileges:true

networks:
  {{ network_name }}:
    driver: {{ network_driver }}

volumes:
  {{ logs_volume }}:
  nginx-logs:
