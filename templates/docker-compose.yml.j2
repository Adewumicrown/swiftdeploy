# Generated by swiftdeploy init — DO NOT EDIT MANUALLY

services:

  api:
    image: {{ service_image }}
    container_name: swiftdeploy-api
    restart: {{ restart_policy }}
    environment:
      MODE: "{{ mode }}"
      APP_VERSION: "{{ app_version }}"
      APP_PORT: "{{ service_port }}"
    networks:
      - {{ network_name }}
    volumes:
      - {{ logs_volume }}:/app/logs
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    healthcheck:
      test: ["CMD-SHELL", "python3 -c \"import urllib.request; urllib.request.urlopen('http://localhost:{{ service_port }}/healthz')\" || exit 1"]
      interval: 15s
      timeout: 10s
      retries: 5
      start_period: 30s

  nginx:
    image: {{ nginx_image }}
    container_name: swiftdeploy-nginx
    restart: {{ restart_policy }}
    ports:
      - "{{ nginx_port }}:{{ nginx_port }}"
    volumes:
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
      - nginx-logs:/var/log/nginx
    networks:
      - {{ network_name }}
    depends_on:
      api:
        condition: service_healthy
    cap_drop:
      - ALL
    cap_add:
      - NET_BIND_SERVICE
      - CHOWN
      - SETUID
      - SETGID
    security_opt:
      - no-new-privileges:true

  opa:
    image: {{ opa_image }}
    container_name: swiftdeploy-opa
    restart: {{ restart_policy }}
    ports:
      - "127.0.0.1:8181:8181"
    command:
      - "run"
      - "--server"
      - "--addr=0.0.0.0:{{ opa_port }}"
      - "--v1-compatible"
      - "--log-format=json"
      - "/policies"
    volumes:
      - ./policies:/policies:ro
    networks:
      - {{ network_name }}
    # OPA is NOT exposed via nginx — CLI only, internal network access
    expose:
      - "{{ opa_port }}"
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://localhost:{{ opa_port }}/health || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s

networks:
  {{ network_name }}:
    driver: {{ network_driver }}

volumes:
  {{ logs_volume }}:
  nginx-logs:
